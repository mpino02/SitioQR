# Copia este archivo como .env y ajusta los valores

# Clave secreta de Django (genera una con:  python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Dominio público donde quedará la app. Es lo que va DENTRO del QR (ej: https://qr.py.cl/r/abc123).
# ¡Defínelo antes de imprimir QR! Si cambia después, los QR impresos dejan de funcionar.
PUBLIC_BASE_URL=http://localhost:9090

# Nombre visible en el panel
APP_NAME=PY QR

# Solo para desarrollo local
DEBUG=false

# ---------- Inicio de sesión con Microsoft (Entra ID) ----------
# Datos del "Registro de aplicaciones" en https://entra.microsoft.com
# Id. de aplicación (cliente)
MS_CLIENT_ID=
# Valor del secreto (Certificados y secretos > Nuevo secreto de cliente). Es el "Valor", no el "Id. de secreto".
MS_CLIENT_SECRET=
# Id. de directorio (inquilino)
MS_TENANT_ID=
# URI de redirección: debe estar registrada EXACTAMENTE igual en la app (plataforma "Web").
# Por defecto: PUBLIC_BASE_URL + /auth/microsoft/callback
# MS_REDIRECT_URI=https://qr.py.cl/auth/microsoft/callback
# Dominios de correo permitidos (separados por coma). Vacío = cualquier cuenta del inquilino.
MS_ALLOWED_DOMAINS=py.cl
# Crear automáticamente el usuario la primera vez que entra con Microsoft (sin permisos de administrador)
MS_AUTO_CREATE_USERS=true
# Mantener también el ingreso con usuario y contraseña de Django (false = solo Microsoft)
LOCAL_LOGIN_ENABLED=true

# (Opcional) Hosts permitidos y orígenes CSRF; por defecto se derivan de PUBLIC_BASE_URL
# ALLOWED_HOSTS=qr.tudominio.cl,localhost
# CSRF_TRUSTED_ORIGINS=https://qr.tudominio.cl

# (Opcional) Base de datos. Por defecto SQLite en ./data/db.sqlite3
# DATA_DIR=/var/lib/pyqr
# DB_ENGINE=postgresql
# DB_NAME=pyqr
# DB_USER=pyqr
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
