# Copia este archivo como .env y ajusta los valores

# Clave secreta de Django (genera una con:  python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Dominio público donde quedará la app. Es lo que va DENTRO del QR (ej: https://qr.py.cl/r/abc123).
# ¡Defínelo antes de imprimir QR! Si cambia después, los QR impresos dejan de funcionar.
PUBLIC_BASE_URL=http://localhost:9090

# Nombre visible en el panel
APP_NAME=PY QR

# Solo para desarrollo local
DEBUG=false

# (Opcional) Hosts permitidos y orígenes CSRF; por defecto se derivan de PUBLIC_BASE_URL
# ALLOWED_HOSTS=qr.tudominio.cl,localhost
# CSRF_TRUSTED_ORIGINS=https://qr.tudominio.cl

# (Opcional) Base de datos. Por defecto SQLite en ./data/db.sqlite3
# DATA_DIR=/var/lib/pyqr
# DB_ENGINE=postgresql
# DB_NAME=pyqr
# DB_USER=pyqr
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
