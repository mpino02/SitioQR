# Copia este archivo como .env y ajusta los valores

# Clave secreta de Django (genera una con:  python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Dominio público donde quedará la app. Es lo que va DENTRO del QR (ej: https://qr.py.cl/r/abc123).
# ¡Defínelo antes de imprimir QR! Si cambia después, los QR impresos dejan de funcionar.
PUBLIC_BASE_URL=http://localhost:9090

# Nombre visible en el panel
APP_NAME=PY QR

# Solo para desarrollo local
DEBUG=false

# ---------- Inicio de sesión con Microsoft (Entra ID) ----------
# Datos del "Registro de aplicaciones" en https://entra.microsoft.com
# Id. de aplicación (cliente)
MS_CLIENT_ID=
# Valor del secreto (Certificados y secretos > Nuevo secreto de cliente). Es el "Valor", no el "Id. de secreto".
MS_CLIENT_SECRET=
# Id. de directorio (inquilino)
MS_TENANT_ID=
# URI de redirección: debe estar registrada EXACTAMENTE igual en la app (plataforma "Web").
# Por defecto: PUBLIC_BASE_URL + /auth/microsoft/callback
# MS_REDIRECT_URI=https://qr.py.cl/auth/microsoft/callback
# Dominios de correo permitidos (separados por coma). Vacío = cualquier cuenta del inquilino.
MS_ALLOWED_DOMAINS=py.cl
# Crear automáticamente el usuario la primera vez que entra con Microsoft (sin permisos de administrador)
MS_AUTO_CREATE_USERS=true
# Perfil de los usuarios nuevos: pending = sin acceso hasta que un super admin le asigne perfil; viewer = solo visualización
# NEW_USER_ROLE=pending
# Mantener también el ingreso con usuario y contraseña de Django (false = solo Microsoft)
LOCAL_LOGIN_ENABLED=true
# /admin/ exige haber entrado con Microsoft (si Microsoft está configurado)
ADMIN_REQUIRE_MICROSOFT=true
# Límite de intentos fallidos de login con contraseña: por usuario, por IP y ventana en segundos
# LOGIN_MAX_FAILURES_USER=5
# LOGIN_MAX_FAILURES_IP=20
# LOGIN_FAILURE_WINDOW=900

# ---------- Cabeceras de seguridad y sesión ----------
# Horas sin actividad antes de cerrar la sesión
# SESSION_IDLE_HOURS=8
# HSTS (solo con HTTPS): segundos que el navegador recordará usar solo HTTPS. Empezar en 1 día y luego 31536000 (1 año)
# HSTS_SECONDS=86400
# Content-Security-Policy: true = solo informa en la consola sin bloquear (para diagnosticar)
# CSP_REPORT_ONLY=false

# (Opcional) Hosts permitidos y orígenes CSRF; por defecto se derivan de PUBLIC_BASE_URL
# ALLOWED_HOSTS=qr.tudominio.cl,localhost
# CSRF_TRUSTED_ORIGINS=https://qr.tudominio.cl

# ---------- Base de datos ----------
# Por defecto SQLite en ./data/db.sqlite3. Los PDF de fichas siempre quedan en DATA_DIR/media (no en la base).
# DATA_DIR=/var/lib/pyqr

# PostgreSQL, opción A: la cadena de conexión que entrega el proveedor (si la clave tiene caracteres
# especiales como @ : / # ?, deben ir codificados: @ -> %40, # -> %23, etc.)
# DATABASE_URL=postgresql://usuario:clave@servidor.nube.com:5432/pyqr?sslmode=require

# PostgreSQL, opción B: datos por separado (no hace falta codificar la clave)
# DB_ENGINE=postgresql
# DB_NAME=pyqr
# DB_USER=pyqr
# DB_PASSWORD=
# DB_HOST=servidor.nube.com
# DB_PORT=5432

# SSL: casi todas las bases en la nube lo exigen. require = cifrado; verify-full = además valida el certificado
# DB_SSLMODE=require
# DB_SSLROOTCERT=/ruta/al/certificado-ca.pem
